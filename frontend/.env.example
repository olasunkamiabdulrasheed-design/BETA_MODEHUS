# Frontend build-time configuration (Vite).
# Copy to .env.production before running `npm run build` for a hosted build.

# Leave empty when the SPA and API are served from the same domain
# (nginx proxies /api and /media to Django). Set it to the API origin
# only if the API lives on a completely separate domain, e.g.:
# VITE_API_URL=https://api.betamodehus.com
VITE_API_URL=