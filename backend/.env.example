# ==========================================================
# BETA_MODEHUS backend environment template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ==========================================================

# --- Django core -----------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Lagos

# --- CORS (frontend origin) ------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Database (production uses PostgreSQL, dev defaults to SQLite) ----------
POSTGRES_DB=betamodehus
POSTGRES_USER=betamodehus
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Email (Gmail SMTP — use an APP PASSWORD from Google, not your login) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=betamodehus@gmail.com
EMAIL_HOST_PASSWORD=
ADMIN_EMAIL=betamodehus@gmail.com
DEFAULT_FROM_EMAIL=BETA_MODEHUS <betamodehus@gmail.com>
STORE_BASE_URL=http://localhost:5173

# --- Cloudinary --------------------------------------------------------------
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OPay (sandbox: https://testapi.opaycheckout.com, live: liveapi...) -------
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_BASE_URL=https://testapi.opaycheckout.com
OPAY_WEBHOOK_SECRET=
# Public callback URL that OPay redirects the customer to after payment:
OPAY_CB_URL=http://localhost:5173/payment/callback

# --- Store defaults (editable later from the admin dashboard) ---------------
DEFAULT_SHIPPING_FEE=3000
DEFAULT_LOW_STOCK_THRESHOLD=5

# --- Throttling -------------------------------------------------------------
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour