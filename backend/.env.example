# Copy to backend/.env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.dev

# Separate frontend origin (leave blank for same-origin dev proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Payments / email / media (all optional in demo mode)
SIMULATE_PAYMENTS=True
DEFAULT_SHIPPING_FEE=3000
EMAIL_HOST_PASSWORD=
CLOUDINARY_URL=
